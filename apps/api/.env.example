# このファイルをコピーして .env を作る：cp .env.example .env
# .env は Git に入らない。本物のパスワードやシークレットは、このファイルに書かない

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# アプリ用の DB ユーザー（yumeguri_app）。ローカルのパスワードは docker/postgres/init/01-roles.sql
DATABASE_URL=

# 画面の場所（CORS で、ここからのブラウザの呼び出しだけを許可する）
WEB_ORIGIN=http://localhost:3000

# ローカルでは、SQS の代わりの LocalStack につなぐ（S1-04 で作ったプロフィール。本物の AWS には届かない）
# staging・本番では設定しない（ECS のタスクロールで、本物の SQS につながる）
AWS_PROFILE=localstack

# ジョブのキューの URL（ローカルは docker/localstack/init/01-resources.sh が作る）
SQS_QUEUE_URL_DEFAULT=http://localhost:4566/000000000000/jobs-default
SQS_QUEUE_URL_HEAVY=http://localhost:4566/000000000000/jobs-heavy

# ---- 以下は DB の準備用の単発のタスク（db-bootstrap。scripts/db-bootstrap.ts）だけが使う ----
# ローカルでは使わない（ローカルの DB のユーザーは docker/postgres/init が作る）
# staging・本番では、ECS のタスク定義が Secrets Manager の値を渡す
DB_HOST=
DB_PORT=
DB_NAME=
DB_ADMIN_USERNAME=
DB_ADMIN_PASSWORD=
MIGRATOR_PASSWORD=
APP_PASSWORD=
WORKER_PASSWORD=
