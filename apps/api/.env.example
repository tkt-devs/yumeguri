# このファイルをコピーして .env を作る：cp .env.example .env
# .env は Git に入らない。本物のパスワードやシークレットは、このファイルに書かない

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# アプリ用の DB ユーザー（yumeguri_app）。ローカルのパスワードは docker/postgres/init/01-roles.sql
DATABASE_URL=

# 画面の場所（CORS で、ここからのブラウザの呼び出しだけを許可する）
WEB_ORIGIN=http://localhost:3000
