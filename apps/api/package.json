{
  "name": "@yumeguri/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "enqueue:debug-add": "tsx --env-file-if-exists=.env scripts/enqueue-debug-add.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1161.0",
    "@hono/node-server": "^2.1.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@yumeguri/shared": "workspace:*",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
