// DB の形（docs/erd.md）。表の名前はモデル名のまま、列の名前は snake_case（@map）
// Prisma で書けない制約（NULLS NOT DISTINCT・CHECK・権限）は、SQL だけのマイグレーションで足す

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
  deleted
}

enum AuthProvider {
  google
}

enum MembershipRole {
  staff
  owner
  org_admin
}

enum PlatformRoleName {
  platform_admin
}

// 公開ページに出るのは published だけ
enum StoreStatus {
  draft
  published
  closed
}

// アップロード中 → 加工中（ワーカー） → 準備完了 / 失敗
enum PhotoStatus {
  uploading
  processing
  ready
  failed
}

// 利用者
model User {
  id          String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  displayName String     @map("display_name")
  // Google から受け取る。一意にしない（本人を表すのは AuthAccount）
  email       String?
  status      UserStatus @default(active)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  authAccounts  AuthAccount[]
  sessions      Session[]
  memberships   Membership[]
  platformRoles PlatformRole[]
}

// ログインの方法
model AuthAccount {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  // ID トークンの sub（Google の中で、その人を表す変わらない値）
  providerSubject String       @map("provider_subject")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

// ログイン中の状態
model Session {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Cookie に入れるランダムな値の SHA-256。値そのものは DB に置かない
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent")
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// 団体（テナント）
model Organization {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  stores      Store[]
}

// 団体・銭湯での役割
model Membership {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  // 団体の管理者は NULL
  storeId        String?        @map("store_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  // 複合外部キー：「A 団体の役割なのに、B 団体の銭湯を指す」行を DB が受け付けない
  // 銭湯を消すときに役割が残っていれば断る（Prisma の初期の SetNull だと、organization_id まで NULL にしようとする）
  store        Store?       @relation(fields: [storeId, organizationId], references: [id, organizationId], onDelete: Restrict)

  // 実際の一意の制約は、NULLS NOT DISTINCT 付きで SQL のマイグレーションが作る
  // （ここに書いておかないと、Prisma が「スキーマにない索引」として消そうとする）
  @@unique([userId, organizationId, storeId, role])
  @@index([userId])
  @@index([organizationId])
}

// システム全体の役割
model PlatformRole {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      PlatformRoleName
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// 監査ログ（追記だけ）。対象が消えてもログは残すので、外部キーにしない
model AuditLog {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id") @db.Uuid
  before         Json?
  after          Json?
  reason         String?
  correlationId  String   @map("correlation_id")
  ipHash         String?  @map("ip_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
}

// 銭湯。どれか1つの団体に属する（テナントの境界の起点）
model Store {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  slug           String      @unique
  name           String
  // わざと NULL を許す（v0.2 で「任意 → 必須」を無停止で変える練習をする。要件定義書 9.5）
  nameKana       String?     @map("name_kana")
  description    String?
  // 例：{"adult": 520, "child": 200}
  prices         Json?
  status         StoreStatus @default(draft)
  // 論理削除（消した印。行は残す）
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id])
  businessHours BusinessHour[]
  photos        Photo[]
  memberships   Membership[]

  // id だけで一意だが、Membership・Visit の複合外部キーの参照先にするために必要
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

// 営業時間。行がない曜日は定休日。同じ曜日に複数の行（朝湯と夕方など）を持てる
// closes_at が opens_at より小さければ、日付をまたぐ営業（例：15:00〜翌1:00）
// 曜日の範囲・opens_at <> closes_at の CHECK は SQL のマイグレーションで足す
model BusinessHour {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  // 0（日）〜6（土）
  weekday   Int      @db.SmallInt
  opensAt   DateTime @map("opens_at") @db.Time(0)
  closesAt  DateTime @map("closes_at") @db.Time(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, weekday])
}

// 写真。ファイルは S3 に置き、ここにはキーだけを持つ（バケット名は環境ごとの設定）
// 「準備完了ならサムネイルがある」の CHECK と、ワーカーの権限は SQL のマイグレーションで足す
model Photo {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  storeId      String      @map("store_id") @db.Uuid
  // 非公開のバケットの、アップロードされた元のファイル
  originalKey  String      @map("original_key")
  // 公開用のバケットの、加工後のファイル。加工が終わるまで NULL
  thumbnailKey String?     @map("thumbnail_key")
  status       PhotoStatus @default(uploading)
  sortOrder    Int         @default(0) @map("sort_order")
  width        Int?
  height       Int?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, sortOrder])
}
